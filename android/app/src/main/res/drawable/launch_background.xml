<?xml version="1.0" encoding="utf-8"?>
<!-- Splash natif Android : vrai logo RecipeMate (fond crème), synchronisé avec
     assets/icon/splash_logo.png et le splash Flutter. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fond vert marque (AppColors.primary = #527C43), comme le splash Flutter. -->
    <item android:drawable="@color/launch_background" />

    <!-- Logo centré, décliné pour chaque densité (160 dp). -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
